# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/docrag

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# SECURITY (generate real keys for production!)
# ============================================
SECRET_KEY=dev-secret-key-change-in-production-abc123
JWT_REFRESH_SECRET_KEY=dev-refresh-secret-change-in-production-xyz789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# STORAGE
# ============================================
STORAGE_PATH=storage/uploads

# ============================================
# EMBEDDING MODEL
# ============================================
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# ============================================
# LLM PROVIDERS
# ============================================
DEFAULT_LLM_PROVIDER=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434