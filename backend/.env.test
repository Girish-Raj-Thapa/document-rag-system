# ── Database ──
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/test_docrag

# ── Redis ──
REDIS_URL=redis://redis:6379/15

# ── JWT Authentication ──
SECRET_KEY=test-secret-key-12345
JWT_REFRESH_SECRET_KEY=test-refresh-secret-key-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=1
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ── File Storage ──
STORAGE_PATH=storage/test_uploads

# ── Celery ──
CELERY_BROKER_URL=redis://redis:6379/14
CELERY_RESULT_BACKEND=redis://redis:6379/13

# ── Embedding Model ──
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ── LLM Providers ──
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
